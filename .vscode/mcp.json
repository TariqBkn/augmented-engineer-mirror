{
  // MCP Servers configuration for the Buvette du Bel'Air project
  // Doc: https://code.visualstudio.com/docs/copilot/chat/mcp-servers
  "servers": {

    // --- Context7 ---
    // Injects up-to-date official library documentation into prompts.
    // Avoids hallucinations caused by outdated model knowledge.
    // Tools: resolve-library-id, get-library-docs
    // Usage: #resolve-library-id #get-library-docs
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },

    // --- Serena ---
    // Semantic code navigation via LSP: find symbols, references, definitions.
    // Requires: uv (https://github.com/astral-sh/uv)
    // Tools: get_symbols_overview, find_symbol, search_for_pattern, get_document_symbols
    "serena": {
      "command": "uvx",
      "args": [
        "serena",
        "--context", "ide-assistant",
        "--project", "${workspaceFolder}"
      ]
    },

    // --- Sequential Thinking ---
    // Forces the agent to decompose its reasoning into explicit sequential steps.
    // Useful for complex refactoring, architecture decisions, debugging.
    // Tools: sequentialthinking
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },

    // --- GitHub MCP ---
    // Direct access to GitHub API: issues, PRs, repos, comments.
    // Requires: GITHUB_PERSONAL_ACCESS_TOKEN env var with scopes repo, read:org
    // ⚠️  Never commit your token. Set it as a system environment variable.
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }

  }
}
